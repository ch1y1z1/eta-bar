{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eta-monitor:snapshot:1.0",
  "title": "ETA Monitor complete snapshot 1.0",
  "description": "One complete UTF-8 JSON object per newline-terminated JSONL record. Additional cross-field and lifecycle rules are specified in docs/protocol.md.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "attempt_id",
    "seq",
    "timestamp",
    "started_at",
    "state",
    "execution",
    "tasks",
    "metrics",
    "error"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "$ref": "#/$defs/id"
    },
    "attempt_id": {
      "$ref": "#/$defs/id"
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "timestamp": {
      "$ref": "#/$defs/utc"
    },
    "started_at": {
      "$ref": "#/$defs/utc"
    },
    "last_progress_at": {
      "$ref": "#/$defs/utc"
    },
    "state": {
      "$ref": "#/$defs/state"
    },
    "execution": {
      "const": "sequential"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "$ref": "#/$defs/task"
      }
    },
    "metrics": {
      "$ref": "#/$defs/scalars"
    },
    "error": {
      "$ref": "#/$defs/error"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "$ref": "#/$defs/errorObject"
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "state": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "scalars": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "string",
          "boolean",
          "null"
        ]
      }
    },
    "errorObject": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/errorObject"
        }
      ]
    },
    "progress": {
      "type": "object",
      "required": [
        "completed",
        "total",
        "unit"
      ],
      "properties": {
        "completed": {
          "type": "number",
          "minimum": 0
        },
        "total": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "additionalProperties": false
    },
    "eta": {
      "type": "object",
      "required": [
        "remaining_seconds",
        "method",
        "updated_at"
      ],
      "properties": {
        "remaining_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "method": {
          "enum": [
            "reported",
            "rate",
            "historical",
            "manual",
            "unknown"
          ]
        },
        "updated_at": {
          "$ref": "#/$defs/utc"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "const": "unknown"
              }
            }
          },
          "then": {
            "properties": {
              "remaining_seconds": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "remaining_seconds": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "method": {
                "const": "unknown"
              }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "required": [
        "id",
        "title",
        "state",
        "progress",
        "eta",
        "dimensions",
        "metrics"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "progress": {
          "$ref": "#/$defs/progress"
        },
        "eta": {
          "$ref": "#/$defs/eta"
        },
        "dimensions": {
          "$ref": "#/$defs/scalars"
        },
        "metrics": {
          "$ref": "#/$defs/scalars"
        }
      },
      "additionalProperties": false
    }
  }
}
